# 文物修复档案协作平台 —— 环境变量样例
# 复制为 .env：cp .env.example .env

# Docker Compose 项目名（容器命名前缀）
COMPOSE_PROJECT_NAME=relic-restore

# 端口映射
FRONTEND_PORT=20110
BACKEND_PORT=21110
DB_PORT=54320

# PostgreSQL
DB_NAME=app_db
DB_USER=app_user
DB_PASSWORD=app_password

# 后端 JWT
JWT_SECRET=local-dev-secret

# 可恢复材料领用链的落地台账文件（容器内路径，挂载命名卷）
STORE_FILE=/data/relic-store.json
